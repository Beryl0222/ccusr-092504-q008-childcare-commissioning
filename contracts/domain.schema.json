{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "托育中心投运协同台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROJECT_FUNDED",
        "MILESTONE_ACCEPTED",
        "ROOM_REGISTERED",
        "REMEDIATION_OPENED",
        "REMEDIATION_CLOSED",
        "REQUIREMENT_VERIFIED",
        "STAFF_QUALIFIED",
        "SHIFT_ASSIGNED",
        "REGULATION_SIGNED",
        "MEDICAL_AGREEMENT_SIGNED",
        "CAPACITY_DECLARED",
        "OWNER_ACKNOWLEDGED",
        "DEMAND_RECORDED",
        "MATERIAL_DEDUPED",
        "RELEASE_APPROVED",
        "SERVICE_RELEASED",
        "TRIAL_RUN_OPENED",
        "DEADLINE_EXTENDED",
        "EXEMPTION_GRANTED",
        "REVIEW_RESUMED",
        "REMINDER_RAISED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "construction_project",
        "facility_room",
        "service_unit",
        "compliance_requirement",
        "staff_member",
        "operating_regulation",
        "medical_agreement",
        "demand_intake",
        "material_registry",
        "operating_release"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
